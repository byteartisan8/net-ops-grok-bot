# NetSim L2VPN lab - environment template (owner: 01-foundation). Never commit .env.
#
# `make env` copies this file to .env and replaces every value "__generate__" with a random secret;
# on later runs it only appends variables that are new here. Empty values are filled in later by the
# component that owns them (noted above each one). No inline comments: compose reads this file.
# Other sessions may append variables for their component in their own section (log it in the contract).

# Fixed compose project name (stable volume names; also set by `name:` in compose.yaml).
COMPOSE_PROJECT_NAME=netsim

# ---------------------------------------------------------------- tokens (contract section 11)
# NetBox read-write token (seeding, remediation). Written by 03-netbox's bootstrap on first start.
NETBOX_TOKEN_RW=
# NetBox read-only token (bot, intent renderer, BSM spec). Written by 03-netbox's bootstrap.
NETBOX_TOKEN_RO=
# Zabbix API token (provisioning, sync, check-now webhook). Written by 04-zabbix's bootstrap.
ZABBIX_API_TOKEN=
# lab-api write endpoints: header X-Lab-Token (05-integration).
LAB_API_TOKEN=__generate__

# ---------------------------------------------------------------- devices (02-device-simulator)
# SNMP v2c read and trap community (contract section 8).
SNMP_COMMUNITY=netsim
# simd signaling bus (core Redis, contract section 4).
CORE_URL=redis://172.30.10.5:6379/0
# Comma-separated host:port list. Port 1162: zabbix/zabbix-docker trunk (MAJOR_VERSION=8.0),
# Dockerfiles/snmptraps/alpine/Dockerfile declares "EXPOSE 1162/udp" (checked 2026-10-18).
# 04-zabbix confirms it on a running container and records it in the contract change log.
TRAP_TARGETS=172.30.10.42:1162

# ---------------------------------------------------------------- NetBox (03-netbox)
NETBOX_SECRET_KEY=__generate__
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@example.com
NETBOX_SUPERUSER_PASSWORD=__generate__
NETBOX_DB_NAME=netbox
NETBOX_DB_USER=netbox
NETBOX_DB_PASSWORD=__generate__
NETBOX_REDIS_PASSWORD=__generate__
NETBOX_REDIS_CACHE_PASSWORD=__generate__
# Pepper of v2 API tokens (NetBox API_TOKEN_PEPPERS[1]); NetBox requires at least 50 characters.
NETBOX_API_TOKEN_PEPPER=__generate__
# Secret of the NetBox -> lab-api webhook: NetBox signs each POST body with HMAC-SHA512 (header X-Hook-Signature).
NETBOX_WEBHOOK_SECRET=__generate__

# ---------------------------------------------------------------- Zabbix (04-zabbix)
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=__generate__
# Replaces the default Admin password on first start.
ZABBIX_ADMIN_PASSWORD=__generate__
# Dedicated API user that owns ZABBIX_API_TOKEN.
ZABBIX_API_USER=netsim-api
ZABBIX_API_PASSWORD=__generate__
# API tokens of the NOC role users noc-engineer, network-engineer, noc-manager (09-noc-roles). Written by
# zabbix-bootstrap; lab-api acknowledges Zabbix problems with them, so Zabbix shows which role acknowledged.
ZABBIX_NOCENG_TOKEN=
ZABBIX_NETENG_TOKEN=
ZABBIX_NOCMGR_TOKEN=

# ---------------------------------------------------------------- grok-bot (07-grok-bot, 09-noc-roles)
# grok-bot is the NOC's office: three roles (NOC Engineer, Network Engineer, NOC Manager), each a Grok Bot app
# routine, work the lab through its /mcp tools. grok-bot reads .env live (no restart), except BOT_MCP_HOSTS.
# observe (the roles diagnose and report only) or propose (default: they file change tickets that a human approves).
BOT_AUTONOMY=propose
# Header X-Operator-Token for approvals and control: the NOC page served by grok-bot carries it, botctl reads it here.
BOT_OPERATOR_TOKEN=__generate__
# Zabbix's media type "NetSim NOC (grok-bot)" posts customer alerts to http://172.30.10.60:8095/hooks/zabbix with
# "Authorization: Bearer <this>" (zabbix-bootstrap copies it into the secret macro {$NETSIM.BOT.HOOK.TOKEN}).
BOT_ZABBIX_HOOK_TOKEN=__generate__
# Alerts that arrive together become one incident and one page: a batch closes BOT_BATCH_S after its latest alert,
# at most BOT_MAX_BATCH_S after its first.
BOT_BATCH_S=10
BOT_MAX_BATCH_S=30
# The roles on /mcp: "Authorization: Bearer <token>"; the token decides the role. These and the terminal tokens below
# are the only secrets that leave this computer (into the Grok Bot app's MCP connectors).
# `uv run botctl mcp-config --role <role>` prints one.
BOT_NOCENG_TOKEN=__generate__
BOT_NETENG_TOKEN=__generate__
BOT_NOCMGR_TOKEN=__generate__
# The roles' terminals: noc-controller on a Bot's own computer reads the Clixon controller through /mcp with its role's
# terminal token, which grok-bot accepts for controller_cli only (the Bot can read every file on its computer, so the
# role token never goes there). Empty: that role's terminal is off. Rotate them after a demo, with the role tokens.
# `uv run botctl terminal-setup --role <role> --url <the /mcp URL>` prints the block to paste into the Bot's chat.
BOT_NOCENG_TERMINAL_TOKEN=__generate__
BOT_NETENG_TERMINAL_TOKEN=__generate__
BOT_NOCMGR_TERMINAL_TOKEN=__generate__
# Host names (comma-separated, *.trycloudflare.com allowed) of the tunnel that publishes /mcp for the Grok Bot app's
# cloud PC. Requests for these hosts reach /mcp and nothing else. Read at start: restart grok-bot after a change.
BOT_MCP_HOSTS=
# The roles' Grok Bot routines ("when a webhook fires"): each one's webhook URL and key (sent as
# "Authorization: Bearer <key>"). Empty URL: that role is not paged (the page is logged as skipped).
BOT_ROUTINE_NOCENG_URL=
BOT_ROUTINE_NOCENG_KEY=
BOT_ROUTINE_NETENG_URL=
BOT_ROUTINE_NETENG_KEY=
BOT_ROUTINE_NOCMGR_URL=
BOT_ROUTINE_NOCMGR_KEY=
# Pages per role and hour (every page starts a paid routine run).
BOT_PAGE_MAX_PER_HOUR=12
# How long an approved field repair takes from "dispatched" to "on site", and how long an Ask-the-NOC question waits
# for the NOC Manager's answer.
BOT_FIELD_DELAY_S=10
BOT_ASK_TIMEOUT_S=600
# How long a change ticket waits for the NOC Manager's review; then it goes to the operator without one.
BOT_REVIEW_TIMEOUT_S=300
# Approve from your phone: grok-bot's phone listener (127.0.0.1:8097) on your tailnet, never on the internet.
# `uv run botctl phone setup` prints the `tailscale serve --https=8097` line and this value for your computer, e.g.
# https://<this computer's tailnet name>:8097. The NOC Manager's reviews then carry links to it, and the NOC room
# signs a phone in with a QR code. Empty: no links; the listener answers on this machine only.
BOT_PHONE_URL=
# How long a signed-in phone stays signed in (days).
BOT_PHONE_SESSION_DAYS=30
