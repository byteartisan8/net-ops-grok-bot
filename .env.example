# NetSim L2VPN lab - environment template (owner: 01-foundation). Never commit .env.
#
# `make env` copies this file to .env and replaces every value "__generate__" with a random secret;
# on later runs it only appends variables that are new here. Empty values are filled in later by the
# component that owns them (noted above each one). No inline comments: compose reads this file.
# Other sessions may append variables for their component in their own section (log it in the contract).

# Fixed compose project name (stable volume names; also set by `name:` in compose.yaml).
COMPOSE_PROJECT_NAME=netsim

# ---------------------------------------------------------------- tokens (contract section 11)
# NetBox read-write token (seeding, remediation). Written by 03-netbox's bootstrap on first start.
NETBOX_TOKEN_RW=
# NetBox read-only token (bot, intent renderer, BSM spec). Written by 03-netbox's bootstrap.
NETBOX_TOKEN_RO=
# Zabbix API token (provisioning, sync, check-now webhook). Written by 04-zabbix's bootstrap.
ZABBIX_API_TOKEN=
# lab-api write endpoints: header X-Lab-Token (05-integration).
LAB_API_TOKEN=__generate__

# ---------------------------------------------------------------- devices (02-device-simulator)
# SNMP v2c read and trap community (contract section 8).
SNMP_COMMUNITY=netsim
# simd signaling bus (core Redis, contract section 4).
CORE_URL=redis://172.30.10.5:6379/0
# Comma-separated host:port list. Port 1162: zabbix/zabbix-docker trunk (MAJOR_VERSION=8.0),
# Dockerfiles/snmptraps/alpine/Dockerfile declares "EXPOSE 1162/udp" (checked 2026-10-18).
# 04-zabbix confirms it on a running container and records it in the contract change log.
TRAP_TARGETS=172.30.10.42:1162

# ---------------------------------------------------------------- NetBox (03-netbox)
NETBOX_SECRET_KEY=__generate__
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@example.com
NETBOX_SUPERUSER_PASSWORD=__generate__
NETBOX_DB_NAME=netbox
NETBOX_DB_USER=netbox
NETBOX_DB_PASSWORD=__generate__
NETBOX_REDIS_PASSWORD=__generate__
NETBOX_REDIS_CACHE_PASSWORD=__generate__
# Pepper of v2 API tokens (NetBox API_TOKEN_PEPPERS[1]); NetBox requires at least 50 characters.
NETBOX_API_TOKEN_PEPPER=__generate__
# Secret of the NetBox -> lab-api webhook: NetBox signs each POST body with HMAC-SHA512 (header X-Hook-Signature).
NETBOX_WEBHOOK_SECRET=__generate__

# ---------------------------------------------------------------- Zabbix (04-zabbix)
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=__generate__
# Replaces the default Admin password on first start.
ZABBIX_ADMIN_PASSWORD=__generate__
# Dedicated API user that owns ZABBIX_API_TOKEN.
ZABBIX_API_USER=netsim-api
ZABBIX_API_PASSWORD=__generate__

# ---------------------------------------------------------------- grok-bot (07-grok-bot)
# xAI API key for the Grok brain (console.x.ai -> API Keys). API usage is billed by xAI, separately from
# SuperGrok / X / Grok Bot subscriptions. Empty: the responders run the deterministic rules brain.
# grok-bot reads .env live: a key added here is used from the next investigation on, no restart needed.
XAI_API_KEY=
# Model (docs.x.ai/developers/models) and reasoning effort: low, medium, high, xhigh, or empty for the model's default.
GROK_MODEL=grok-4.7
GROK_REASONING_EFFORT=
# auto (Grok when XAI_API_KEY is set, else rules), grok or rules.
BOT_BRAIN=auto
# observe (diagnose only), propose (every fix waits for a human) or auto (fixes approved by policy: lab only).
BOT_AUTONOMY=propose
# Grok spend per UTC day (USD) before the rules brain takes over.
BOT_DAILY_BUDGET_USD=5
# Header X-Operator-Token for approvals and control: the NOC page served by grok-bot carries it, botctl reads it here.
BOT_OPERATOR_TOKEN=__generate__
# Outside agents (the Grok Bot app, any MCP client): "Authorization: Bearer <this>" for http://127.0.0.1:8095/mcp.
# It reads, proposes and leaves notes; it cannot approve. Empty: /mcp is off. `uv run botctl mcp-config` prints the
# JSON to paste into the Grok Bot app. BOT_AGENT_NAME is the visitor robot's name in the NOC room.
BOT_AGENT_TOKEN=__generate__
BOT_AGENT_NAME=GROK
# Host names (comma-separated, *.example.com allowed) of a tunnel that publishes /mcp for a cloud agent. Requests
# for these hosts reach /mcp and nothing else. Empty: /mcp answers on 127.0.0.1 only.
BOT_MCP_HOSTS=
# The pager: one webhook per incident, e.g. a Grok Bot routine "when a webhook fires" (its webhook URL, and its key
# without "Bearer "). Empty URL: no pages. Events: opened, diagnosed, resolved (comma-separated).
BOT_PAGER_URL=
BOT_PAGER_TOKEN=
BOT_PAGER_EVENTS=opened
BOT_PAGER_MIN_SEVERITY=Average
BOT_PAGER_MAX_PER_HOUR=6
