{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netsim:schema:bsm-spec",
  "description": "BSM spec (docs/CONTRACT.md section 9.3). Generated from netsim_common.bsm.BsmSpec.",
  "$defs": {
    "BsmCustomer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "tags": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Zabbix service tags; spec-derived tags are mandatory, extra tags allowed",
          "title": "Tags",
          "type": "object"
        },
        "description": {
          "description": "Human-readable spec of the node, including its NetBox URL when known",
          "title": "Description",
          "type": "string"
        },
        "netbox_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "NetBox UI URL of the source object (null if not from NetBox)",
          "title": "Netbox Url"
        },
        "sla_tier": {
          "$ref": "#/$defs/SlaTier"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/BsmService"
          },
          "title": "Services",
          "type": "array"
        }
      },
      "required": [
        "name",
        "tags",
        "description",
        "sla_tier"
      ],
      "title": "BsmCustomer",
      "type": "object"
    },
    "BsmPseudowire": {
      "additionalProperties": false,
      "description": "Leaf: one pseudowire. Matches problems tagged scope=l2vpn-pw, service, pw_role from both ends.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "tags": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Zabbix service tags; spec-derived tags are mandatory, extra tags allowed",
          "title": "Tags",
          "type": "object"
        },
        "description": {
          "description": "Human-readable spec of the node, including its NetBox URL when known",
          "title": "Description",
          "type": "string"
        },
        "netbox_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "NetBox UI URL of the source object (null if not from NetBox)",
          "title": "Netbox Url"
        },
        "role": {
          "$ref": "#/$defs/PwRole"
        },
        "vc_id": {
          "description": "Pseudowire VC ID",
          "maximum": 4294967295,
          "minimum": 1,
          "title": "Vc Id",
          "type": "integer"
        },
        "netbox_l2vpn_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "NetBox L2VPN object ID (null if not from NetBox)",
          "title": "Netbox L2Vpn Id"
        },
        "ends": {
          "description": "[a-end (spoke), z-end (hub)]",
          "items": {
            "$ref": "#/$defs/PwEnd"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Ends",
          "type": "array"
        }
      },
      "required": [
        "name",
        "tags",
        "description",
        "role",
        "vc_id",
        "ends"
      ],
      "title": "BsmPseudowire",
      "type": "object"
    },
    "BsmRoot": {
      "additionalProperties": false,
      "description": "Root node ``L2VPN``: most critical child.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "tags": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Zabbix service tags; spec-derived tags are mandatory, extra tags allowed",
          "title": "Tags",
          "type": "object"
        },
        "description": {
          "description": "Human-readable spec of the node, including its NetBox URL when known",
          "title": "Description",
          "type": "string"
        },
        "netbox_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "NetBox UI URL of the source object (null if not from NetBox)",
          "title": "Netbox Url"
        }
      },
      "required": [
        "name",
        "tags",
        "description"
      ],
      "title": "BsmRoot",
      "type": "object"
    },
    "BsmService": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "tags": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Zabbix service tags; spec-derived tags are mandatory, extra tags allowed",
          "title": "Tags",
          "type": "object"
        },
        "description": {
          "description": "Human-readable spec of the node, including its NetBox URL when known",
          "title": "Description",
          "type": "string"
        },
        "netbox_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "NetBox UI URL of the source object (null if not from NetBox)",
          "title": "Netbox Url"
        },
        "service_id": {
          "description": "Service identifier SVC-NNNN",
          "examples": [
            "SVC-0001"
          ],
          "pattern": "^SVC-[0-9]{4}$",
          "title": "Service Id",
          "type": "string"
        },
        "spoke": {
          "description": "Hostname (a DNS label)",
          "examples": [
            "spoke-1"
          ],
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$",
          "title": "Spoke",
          "type": "string"
        },
        "status_rules": {
          "$ref": "#/$defs/StatusRules",
          "description": "redundant-pair with two PW leaves (dual-homed), unprotected with one (single-homed)"
        },
        "pseudowires": {
          "items": {
            "$ref": "#/$defs/BsmPseudowire"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Pseudowires",
          "type": "array"
        }
      },
      "required": [
        "name",
        "tags",
        "description",
        "service_id",
        "spoke",
        "status_rules",
        "pseudowires"
      ],
      "title": "BsmService",
      "type": "object"
    },
    "PwEnd": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "description": "Hostname (a DNS label)",
          "examples": [
            "spoke-1"
          ],
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$",
          "title": "Host",
          "type": "string"
        },
        "ac": {
          "description": "Attachment circuit (subinterface) on this host",
          "examples": [
            "GigabitEthernet0/0/1.101"
          ],
          "maxLength": 80,
          "minLength": 1,
          "title": "Ac",
          "type": "string"
        },
        "expected_peer": {
          "description": "PW peer address this end must be configured with (the other end's loopback)",
          "examples": [
            "10.255.0.1"
          ],
          "pattern": "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$",
          "title": "Expected Peer",
          "type": "string"
        }
      },
      "required": [
        "host",
        "ac",
        "expected_peer"
      ],
      "title": "PwEnd",
      "type": "object"
    },
    "PwRole": {
      "description": "Pseudowire role (YANG ``nsd:pw-role``).\n\nDefinition order is the YANG enum order and the canonical list order (primary first).",
      "enum": [
        "primary",
        "backup"
      ],
      "title": "PwRole",
      "type": "string"
    },
    "SlaTier": {
      "description": "NetBox tenant custom field ``sla_tier`` (contract section 10).",
      "enum": [
        "gold",
        "silver",
        "bronze"
      ],
      "title": "SlaTier",
      "type": "string"
    },
    "StatusRules": {
      "description": "Status calculation of a service node (contract section 9.4), set by its number of PW leaves.",
      "enum": [
        "redundant-pair",
        "unprotected"
      ],
      "title": "StatusRules",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "root": {
      "$ref": "#/$defs/BsmRoot"
    },
    "customers": {
      "items": {
        "$ref": "#/$defs/BsmCustomer"
      },
      "title": "Customers",
      "type": "array"
    }
  },
  "required": [
    "root",
    "customers"
  ],
  "title": "NetSim BSM spec",
  "type": "object"
}
